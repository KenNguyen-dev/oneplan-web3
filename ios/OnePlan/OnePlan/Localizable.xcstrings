    },
    "You are preparing to end your trip." : {
      "comment" : "A heading for the review screen.",
      "isCommentAutoGenerated" : true
    },
    "You can only rate plans you've completed." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn chỉ có thể đánh giá những kế hoạch đã hoàn thành."
          }
        }
      }
    },
    "You do not need to install anything, and there is no seed phrase to write down or lose. Your access comes from the account you already sign in with." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn không cần cài thêm gì, cũng không có cụm từ khôi phục phải ghi lại hay sợ mất. Bạn truy cập bằng chính tài khoản đang dùng để đăng nhập."
          }
        }
      }
    },
    "You don't have access to scan receipts for this trip." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn không có quyền quét hóa đơn cho chuyến đi này."

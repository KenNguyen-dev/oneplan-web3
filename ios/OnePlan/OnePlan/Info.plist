<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Without this the .ttf files ship inside the app but iOS never registers
	     them, and every Font.custom("BeVietnamPro-…") call in the app silently
	     falls back to the system font. Nothing crashes and nothing warns.
	     OnePlanTests/FontRegistrationTests guards it. -->
	<key>UIAppFonts</key>
	<array>
		<string>BeVietnamPro-Thin.ttf</string>
		<string>BeVietnamPro-ThinItalic.ttf</string>
		<string>BeVietnamPro-ExtraLight.ttf</string>
		<string>BeVietnamPro-ExtraLightItalic.ttf</string>
		<string>BeVietnamPro-Light.ttf</string>
		<string>BeVietnamPro-LightItalic.ttf</string>
		<string>BeVietnamPro-Regular.ttf</string>
		<string>BeVietnamPro-Italic.ttf</string>
		<string>BeVietnamPro-Medium.ttf</string>
		<string>BeVietnamPro-MediumItalic.ttf</string>
		<string>BeVietnamPro-SemiBold.ttf</string>
		<string>BeVietnamPro-SemiBoldItalic.ttf</string>
		<string>BeVietnamPro-Bold.ttf</string>
		<string>BeVietnamPro-BoldItalic.ttf</string>
		<string>BeVietnamPro-ExtraBold.ttf</string>
		<string>BeVietnamPro-ExtraBoldItalic.ttf</string>
		<string>BeVietnamPro-Black.ttf</string>
		<string>BeVietnamPro-BlackItalic.ttf</string>
		<string>InstrumentSerif-Regular.ttf</string>
		<string>InstrumentSerif-Italic.ttf</string>
	</array>
	<!-- Where a Debug build finds the server. localhost only resolves in the
	     simulator; a real device needs the Mac's address on the LAN. Change this
	     when the network changes, and both reach the same server. -->
	<key>LocalAPIHost</key>
	<string>http://192.168.2.200:3000</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Covers plain HTTP to private addresses, which the exception below
		     does not: it names localhost only, so a LAN address would be blocked
		     before the request left the app. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>lumilabs.oneplan</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>oneplan</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>Google Sign-In</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.559176877871-535pl0kskgdabrdg41h6nr03ira3vvmk</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>instagram-stories</string>
	</array>
	<key>GIDClientID</key>
	<string>559176877871-535pl0kskgdabrdg41h6nr03ira3vvmk.apps.googleusercontent.com</string>
	<key>PrivyAppID</key>
	<string>cms1ulo4i00040djvsi6iz5gv</string>
	<!-- From the Privy dashboard, Clients tab. Both keys must be set or
	     WalletService reports .notConfigured and the vault stays unavailable.
	     Privy keeps one client per environment and matches it against the
	     bundle identifier, so this is the local.lumilabs.oneplan client to go
	     with the Debug bundle id. A Dev or Release build needs the client that
	     matches its own bundle id, and that client must list it under App
	     identifiers or the SDK returns 403 invalid_native_app_id. -->
	<key>PrivyAppClientID</key>
	<string>$(PRIVY_APP_CLIENT_ID)</string>
</dict>
</plist>
